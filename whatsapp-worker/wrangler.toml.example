name = "meu-gasto-ia-whatsapp"
main = "src/index.js"
compatibility_date = "2026-10-01"

[[d1_databases]]
binding = "DB"
database_name = "meu-gasto-ia"
database_id = "COLOQUE_O_ID_DO_D1_AQUI"

[vars]
META_API_VERSION = "v23.0"

# Cadastre com `wrangler secret put`, nunca neste arquivo:
# META_VERIFY_TOKEN
# META_ACCESS_TOKEN
# META_APP_SECRET
# META_PHONE_NUMBER_ID
# PHONE_HASH_SECRET
# ADMIN_API_TOKEN
